   <!ENTITY environment
    '
   <configuration>
    &if_this_target;

    <config>

   EXEC_ADA := "${EXEC(Ada)}";
   EXEC_C   := "${EXEC(C)}";
   EXEC_CPP := "${EXEC(C++)}";
   EXEC_CPREP := "${EXEC(CPREP)}";

   HOST_ADA := "${HOST(Ada)}";
   HOST_C   := "${HOST(C)}";
   HOST_CPP := "${HOST(C++)}";
   HOST_CPREP := "${HOST(CPREP)}";

   TARGET_ADA := "${TARGET(Ada)}";
   TARGET_C   := "${TARGET(C)}";
   TARGET_CPP := "${TARGET(C++)}";
   TARGET_CPREP   := "${TARGET(CPREP)}";
   TARGET     := "${TARGET(*)}";

   VERSION_ADA := "${VERSION(Ada)}";
   VERSION_C   := "${VERSION(C)}";
   VERSION_CPP := "${VERSION(C++)}";
   VERSION_CPREP   := "${VERSION(CPREP)}";

   PREFIX_ADA := "${PREFIX(Ada)}";
   PREFIX_C   := "${PREFIX(C)}";
   PREFIX_CPP := "${PREFIX(C++)}";
   PREFIX_CPREP   := "${PREFIX(CPREP)}";

   PATH_ADA := "${PATH(Ada)}";
   PATH_C   := "${PATH(C)}";
   PATH_CPP := "${PATH(C++)}";
   PATH_CPREP   := "${PATH(CPREP)}";

   RUNTIME_ADA := "${RUNTIME(Ada)}";
   RUNTIME_C   := "${RUNTIME(C)}";
   RUNTIME_CPP := "${RUNTIME(C++)}";
   RUNTIME_CPREP   := "${RUNTIME(CPREP)}";

   GPRCONFIG_PREFIX := "${GPRCONFIG_PREFIX}";

    </config>
   </configuration>
    '
   >

